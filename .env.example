# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored; this file documents which settings exist.

# --- Postgres 16 + pgvector (Docker) ---
POSTGRES_USER=chatalog
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=chatalog
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chatalog:change-me-locally@localhost:5432/chatalog

# --- LLM layer (all model names come from here, never from code) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Provisional; will be chosen by extraction evals (see DECISIONS.md)
EXTRACT_MODEL=qwen3:4b

# --- Strong judge model (fidelity checks only, weeks 3–4) ---
# Left empty until needed. Spend cap of 0 means paid calls are disabled.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_MONTHLY_SPEND_CAP_USD=0
